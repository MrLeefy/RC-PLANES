+## True when the paint along the edge leaves the endpoints' paints (a stripe or island inside the edge).
+## Decided per edge and cached, so both triangles that share an edge make the same decision.
+func _edge_needs_split(u: int, v: int, refine_fn: Callable) -> bool:
+	var key := Vector2i(mini(u, v), maxi(u, v))
+	if _edge_split_cache.has(key):
+		return _edge_split_cache[key]
+	var result := false
+	if verts[u].distance_to(verts[v]) > EDGE_MIN_LENGTH:
+		var cu := cols[u]
+		var cv := cols[v]
+		var same := _same_paint(cu, cv)
+		for t in EDGE_SAMPLES:
+			var col := _edge_paint(u, v, t, refine_fn)
+			var foreign := (not _same_paint(col, cu)) if same else (not (_same_paint(col, cu) or _same_paint(col, cv)))
+			if foreign:
+				result = true
+				break
+	_edge_split_cache[key] = result
+	return result
+
+## Midpoint of edge (u, v), shared by every triangle on that edge.
+func _mid_vertex(u: int, v: int, refine_fn: Callable) -> int:
+	var key := Vector2i(mini(u, v), maxi(u, v))
+	if not _mid_cache.has(key):
+		var p := verts[u].lerp(verts[v], 0.5)
+		var n := norms[u].lerp(norms[v], 0.5).normalized()
+		var col := _edge_paint(u, v, 0.5, refine_fn)
+		_mid_cache[key] = _add_v(p, n, col, uvs[u].lerp(uvs[v], 0.5))
+	return int(_mid_cache[key])
