+## Paint at parameter t along edge (u, v), with the interpolated normal.
+func _edge_paint(u: int, v: int, t: float, refine_fn: Callable) -> Color:
+	var p := verts[u].lerp(verts[v], t)
+	var n := norms[u].lerp(norms[v], t).normalized()
+	return refine_fn.call(p, n, false) if refine_fn.get_argument_count() >= 3 else refine_fn.call(p, n)
