extends SceneTree
## Compares legacy procedural construction against the baked static path.
## Requires baked assets generated by tools/bake_legacy_aircraft.gd.

const BakedLibrary = preload("res://scripts/aircraft/aircraft_baked_library.gd")

func _initialize() -> void:
	call_deferred("_run")

func _default_cfg() -> Dictionary:
	return {"battery": 0, "prop": 0, "cg": 0.0, "throws": "high", "fuel": 1.0, "engine": 0}

func _run() -> void:
	var cfg := _default_cfg()
	var tested := 0
	var legacy_total := 0.0
	var baked_total := 0.0

	for definition in AircraftDB.all():
		var id := String(definition["id"])
		if not BakedLibrary.has_baked(id, 2):
			continue

		var t0 := Time.get_ticks_usec()
		var builder := AircraftBuilder.new()
		var legacy := builder.build(definition, cfg, 2)
		var t1 := Time.get_ticks_usec()

		var t2 := Time.get_ticks_usec()
		var baked := BakedLibrary.instantiate(definition, cfg, 2)
		var t3 := Time.get_ticks_usec()
		if baked.is_empty():
			push_error("%s baked load failed" % id)
			(legacy["root"] as Node).free()
			quit(2)
			return

		var bbuild: Dictionary = baked["build"]
		var matches := (
			(legacy["comps"] as Array).size() == (bbuild["comps"] as Array).size()
			and (legacy["panels"] as Array).size() == (bbuild["panels"] as Array).size()
			and (legacy["surfaces"] as Array).size() == (bbuild["surfaces"] as Array).size()
			and (legacy["engines"] as Array).size() == (bbuild["engines"] as Array).size()
			and (legacy["wheels"] as Array).size() == (bbuild["wheels"] as Array).size()
		)
		if not matches:
			push_error("%s baked structure does not match legacy blueprint" % id)
			(legacy["root"] as Node).free()
			(bbuild["root"] as Node).free()
			quit(3)
			return

		var legacy_ms := (t1 - t0) / 1000.0
		var baked_ms := (t3 - t2) / 1000.0
		legacy_total += legacy_ms
		baked_total += baked_ms
		tested += 1
		print("%s legacy=%.3f ms baked=%.3f ms speedup=%.1fx" % [
			id, legacy_ms, baked_ms, legacy_ms / maxf(baked_ms, 0.001)
		])
		(legacy["root"] as Node).free()
		(bbuild["root"] as Node).free()

	if tested == 0:
		push_error("No baked aircraft found; run tools/bake_legacy_aircraft.gd first")
		quit(4)
		return

	print("TOTAL aircraft=%d legacy=%.3f ms baked=%.3f ms speedup=%.1fx" % [
		tested, legacy_total, baked_total, legacy_total / maxf(baked_total, 0.001)
	])
	quit()
